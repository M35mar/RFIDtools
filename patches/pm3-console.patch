+// Stops a running Lua script at the next instruction batch when the host
+// requests it. g_user_interrupt is reset before the next console command.
+static void lua_interrupt_hook(lua_State *L, lua_Debug *ar) {
+    (void) ar;
+    if (g_user_interrupt) {
+        luaL_error(L, "stopped by user");
+    }
+}
+
+// Routes Lua's global print(...) into the grabbed console output so scripts
+// stream verbose progress and menus live on Android.
+static int lua_android_print(lua_State *L) {
+    int n = lua_gettop(L);
+    luaL_Buffer b;
+    luaL_buffinit(L, &b);
+    for (int i = 1; i <= n; i++) {
+        size_t len = 0;
+        const char *s = luaL_tolstring(L, i, &len);
+        if (i > 1) {
+            luaL_addchar(&b, '\t');
+        }
+        if (s != NULL && len > 0) {
+            luaL_addlstring(&b, s, len);
+        }
+        lua_pop(L, 1);
+    }
+    luaL_addchar(&b, '\n');
+    luaL_pushresult(&b);
+    const char *text = lua_tostring(L, -1);
+    if (text != NULL) {
+        grabber_append(text);
+    }
+    lua_pop(L, 1);
+    return 0;
+}
+
+// Routes io.write(...) directly into the console grabber without forcing a
+// trailing newline, so interactive prompts ("Select > ") show up immediately.
+static int lua_android_io_write(lua_State *L) {
+    int n = lua_gettop(L);
+    luaL_Buffer b;
+    luaL_buffinit(L, &b);
+    for (int i = 1; i <= n; i++) {
+        size_t len = 0;
+        const char *s = luaL_tolstring(L, i, &len);
+        if (s != NULL && len > 0) {
+            luaL_addlstring(&b, s, len);
+        }
+        lua_pop(L, 1);
+    }
+    luaL_pushresult(&b);
+    const char *text = lua_tostring(L, -1);
+    if (text != NULL && text[0] != '\0') {
+        grabber_append(text);
+    }
+    lua_pop(L, 1);
+    lua_getglobal(L, "io");
+    lua_getfield(L, -1, "stdout");
+    lua_remove(L, -2);
+    return 1;
+}
+
+// Routes io.read(...) through the Android console interactive input bridge so
+// Lua menus, utils.confirm() and utils.input() work just like on desktop.
+static int lua_android_io_read(lua_State *L) {
+    const char *fmt = luaL_optstring(L, 1, "*l");
+    char *line = pm3_input_read_line();
+    if (line == NULL) {
+        if (g_user_interrupt) {
+            return luaL_error(L, "stopped by user");
+        }
+        lua_pushnil(L);
+        return 1;
+    }
+    // Echo the reply into the console transcript.
+    grabber_append(line);
+    grabber_append("\n");
+    if (strcmp(fmt, "*L") == 0 || strcmp(fmt, "L") == 0) {
+        lua_pushfstring(L, "%s\n", line);
+    } else if (strcmp(fmt, "*n") == 0 || strcmp(fmt, "n") == 0) {
+        char *end = NULL;
+        double num = strtod(line, &end);
+        if (end != line) {
+            lua_pushnumber(L, num);
+        } else {
+            lua_pushnil(L);
+        }
+    } else {
+        lua_pushstring(L, line);
+    }
+    free(line);
+    return 1;
+}
+
+static void lua_install_android_io(lua_State *L) {
+    lua_pushcfunction(L, lua_android_print);
+    lua_setglobal(L, "print");
+
+    lua_getglobal(L, "io");
+    if (lua_istable(L, -1)) {
+        lua_pushcfunction(L, lua_android_io_write);
+        lua_setfield(L, -2, "write");
+        lua_pushcfunction(L, lua_android_io_read);
+        lua_setfield(L, -2, "read");
+    }
+    lua_pop(L, 1);
+}
