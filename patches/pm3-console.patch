+
+// Copy out the grabbed output and clear what was copied. Safe to call while a
+// command is running: the caller owns (and must free) the returned string.
+// With hold_incomplete_utf8, a multibyte sequence split across two drains is
+// left in the buffer for the next call instead of being cut in half.
+static char *grabber_take(bool hold_incomplete_utf8) {
+    pthread_mutex_lock(&g_grabber_lock);
+    if (hold_incomplete_utf8 && g_grabber_capture) {
+        pthread_mutex_unlock(&g_grabber_lock);
+        return NULL;
+    }
+    char *copy = NULL;
+    size_t len = g_grabbed_output.idx;
+    if (g_grabbed_output.ptr != NULL && len > 0) {
+        size_t cut = len;
+        if (hold_incomplete_utf8) {
+            size_t i = len;
+            size_t continuation = 0;
+            while (i > 0 && continuation < 3) {
+                unsigned char c = (unsigned char) g_grabbed_output.ptr[i - 1];
+                if ((c & 0xC0) != 0x80) {
+                    size_t need = 1;
+                    if ((c & 0xE0) == 0xC0) {
+                        need = 2;
+                    } else if ((c & 0xF0) == 0xE0) {
+                        need = 3;
+                    } else if ((c & 0xF8) == 0xF0) {
+                        need = 4;
+                    }
+                    if (i - 1 + need > len) {
+                        cut = i - 1;
+                    }
+                    break;
+                }
+                i--;
+                continuation++;
+            }
+        }
+        if (cut > 0) {
+            copy = malloc(cut + 1);
+            if (copy != NULL) {
+                memcpy(copy, g_grabbed_output.ptr, cut);
+                copy[cut] = '\0';
+                if (cut < len) {
+                    memmove(g_grabbed_output.ptr, g_grabbed_output.ptr + cut, len - cut);
+                }
+                g_grabbed_output.idx = len - cut;
+            }
+        }
+    }
+    pthread_mutex_unlock(&g_grabber_lock);
+    return copy;
+}
+
+// Complete, still valid UTF-8 only: used by the streaming poller.
+char *grabber_take_copy(void) {
+    return grabber_take(true);
+}
+
+// Everything, including a trailing partial character: used at command end.
+char *grabber_take_all(void) {
+    return grabber_take(false);
+}
+
+// A script is about to capture a nested command's output: start from empty and
+// keep the streaming drain out of the way until grabber_capture_end().
+void grabber_capture_begin(void) {
+    pthread_mutex_lock(&g_grabber_lock);
+    g_grabber_capture = true;
+    g_grabbed_output.idx = 0;
+    pthread_mutex_unlock(&g_grabber_lock);
+}
+
+// Hands the captured text to the caller (free it with free()). The buffer is
+// cleared, since the script owns the copy.
+char *grabber_capture_end(void) {
+    pthread_mutex_lock(&g_grabber_lock);
+    char *copy = NULL;
+    if (g_grabbed_output.ptr != NULL) {
+        copy = malloc(g_grabbed_output.idx + 1);
+        if (copy != NULL) {
+            memcpy(copy, g_grabbed_output.ptr, g_grabbed_output.idx);
+            copy[g_grabbed_output.idx] = '\0';
+        }
+    }
+    g_grabbed_output.idx = 0;
+    g_grabber_capture = false;
+    pthread_mutex_unlock(&g_grabber_lock);
+    return copy;
 }
 
