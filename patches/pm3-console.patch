+static pthread_mutex_t g_input_lock = PTHREAD_MUTEX_INITIALIZER;
+static pthread_cond_t g_input_cond = PTHREAD_COND_INITIALIZER;
+static bool g_input_waiting = false;
+static bool g_input_ready = false;
+static char *g_input_line = NULL;
+
+void pm3_input_provide(const char *line) {
+    pthread_mutex_lock(&g_input_lock);
+    free(g_input_line);
+    g_input_line = strdup(line != NULL ? line : "");
+    g_input_ready = true;
+    pthread_cond_broadcast(&g_input_cond);
+    pthread_mutex_unlock(&g_input_lock);
+}
+
+void pm3_input_cancel(void) {
+    pthread_mutex_lock(&g_input_lock);
+    free(g_input_line);
+    g_input_line = NULL;
+    g_input_ready = false;
+    pthread_cond_broadcast(&g_input_cond);
+    pthread_mutex_unlock(&g_input_lock);
+}
+
+bool pm3_input_is_waiting(void) {
+    pthread_mutex_lock(&g_input_lock);
+    bool waiting = g_input_waiting;
+    pthread_mutex_unlock(&g_input_lock);
+    return waiting;
+}
+
+char *pm3_input_read_line(void) {
+    pthread_mutex_lock(&g_input_lock);
+    g_input_waiting = true;
+    while (!g_input_ready && !g_user_interrupt) {
+        pthread_cond_wait(&g_input_cond, &g_input_lock);
+    }
+    g_input_waiting = false;
+    char *result = NULL;
+    if (!g_user_interrupt && g_input_ready) {
+        result = g_input_line;
+        g_input_line = NULL;
+    } else {
+        free(g_input_line);
+        g_input_line = NULL;
+    }
+    g_input_ready = false;
+    pthread_mutex_unlock(&g_input_lock);
+    return result;
 }
 
